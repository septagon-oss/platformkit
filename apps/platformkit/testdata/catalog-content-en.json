{
  "module": "content",
  "entity": "content",
  "path": "/api/v1/content/contents",
  "fields": [
    {
      "name": "id",
      "type": "uuid",
      "readOnly": true
    },
    {
      "name": "createdAt",
      "type": "time",
      "readOnly": true
    },
    {
      "name": "updatedAt",
      "type": "time",
      "readOnly": true
    },
    {
      "name": "slug",
      "type": "string",
      "maxLength": 200,
      "required": true,
      "doc": "URL name, unique within the tenant",
      "presentation": {
        "label": "Address name",
        "help": "Used to build this page's web address"
      }
    },
    {
      "name": "title",
      "type": "string",
      "maxLength": 200,
      "required": true,
      "doc": "Headline",
      "translatable": true
    },
    {
      "name": "body",
      "type": "text",
      "widget": "richtext",
      "maxLength": 262144,
      "hideList": true,
      "doc": "The content itself, in Markdown",
      "translatable": true
    },
    {
      "name": "coverImageId",
      "type": "uuid",
      "present": "image",
      "doc": "File id of the cover picture",
      "presentation": {
        "label": "Cover",
        "help": "File id of the cover picture"
      }
    },
    {
      "name": "kind",
      "type": "string",
      "widget": "select",
      "enum": [
        "page",
        "post"
      ],
      "default": "post",
      "doc": "page or post",
      "presentation": {
        "label": "Type"
      }
    },
    {
      "name": "status",
      "type": "string",
      "widget": "select",
      "enum": [
        "draft",
        "published",
        "archived"
      ],
      "default": "draft",
      "doc": "Lifecycle state",
      "presentation": {
        "enumTones": {
          "archived": "neutral",
          "draft": "neutral",
          "published": "success"
        }
      }
    },
    {
      "name": "publishedAt",
      "type": "time",
      "widget": "datetime",
      "doc": "When this was published",
      "presentation": {
        "label": "Published"
      }
    },
    {
      "name": "author",
      "type": "uuid",
      "doc": "The user who created this",
      "presentation": {
        "visibility": "detail",
        "reference": {
          "resource": "user/user"
        }
      }
    },
    {
      "name": "revision",
      "type": "int",
      "doc": "This row's own write count, from 1"
    }
  ],
  "presentation": {
    "deck": {
      "queue": [
        "status:draft"
      ],
      "order": "updatedAt",
      "directions": {
        "down": {
          "skip": true
        },
        "left": {
          "command": "archive",
          "label": "Archive",
          "tone": "warning",
          "icon": "folder"
        },
        "right": {
          "command": "publish",
          "label": "Publish",
          "tone": "success",
          "icon": "document"
        }
      }
    },
    "singular": "page",
    "plural": "pages",
    "description": "Write, review and publish the pages your audience sees.",
