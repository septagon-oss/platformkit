      "presentation": {
        "label": "Estado",
        "help": "Estado do ciclo de vida",
        "enumLabels": {
          "archived": "Arquivado",
          "draft": "Rascunho",
          "published": "Publicado"
        },
        "enumTones": {
          "archived": "neutral",
          "draft": "neutral",
          "published": "success"
        }
