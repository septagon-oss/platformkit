  "writable": true,
  "commands": [
    {
      "verb": "restore",
      "summary": "Restore a version of this content",
      "description": "Writes a new version with the stored one's content. No version is changed or removed, and the row's lifecycle fields are not replayed.",
      "fields": [
        {
          "name": "version",
          "type": "int",
          "doc": "The version to write back, as the list answered it"
        },
        {
          "name": "locale",
          "type": "string",
          "doc": "The series to read it from; the record's own language when unset"
        },
        {
          "name": "expectedRevision",
          "type": "int",
          "doc": "The row's write count as the caller read it; a row past it is refused with 412 and writes nothing"
        }
      ],
      "presentation": {
        "label": "Restaurar esta versão",
        "confirmation": {
          "title": "Restaurar esta versão?",
          "body": "Será gravada uma nova versão com este conteúdo. Nada é eliminado.",
          "confirmLabel": "Restaurar"
        },
        "successMessage": "Foi gravada uma nova versão com o conteúdo que restaurou."
      }
    },
    {
      "verb": "translate",
      "summary": "Translate a content",
      "description": "Writes this language's text of the named fields, stamped as typed by a person. The record's own fields are untouched.",
      "fields": [
        {
          "name": "lang",
          "type": "string",
          "doc": "The language being written: a tag this tenant is served in, other than its own"
        },
        {
          "name": "values",
          "type": "map",
          "elem": "string",
          "keys": [
            {
              "name": "title",
              "label": "Title",
              "widget": "text"
            },
            {
              "name": "body",
              "label": "Body",
              "widget": "textarea"
            }
          ],
          "doc": "The text of each translatable field, keyed by field name"
        },
        {
          "name": "expected",
          "type": "map",
          "elem": "int",
          "keys": [
            {
              "name": "title",
              "label": "Title",
              "widget": "hidden",
              "from": "revision"
            },
            {
              "name": "body",
              "label": "Body",
              "widget": "hidden",
              "from": "revision"
            }
          ],
          "doc": "Each field's revision as read; 0 for a field with no translation yet"
        }
      ]
    },
    {
      "verb": "review-translation",
      "summary": "Mark a content's translation reviewed",
      "description": "Names the fields a person has checked against the source. A field whose source has moved since it was translated is refused.",
      "fields": [
        {
          "name": "lang",
          "type": "string",
          "doc": "The language this acts on: a tag this tenant is served in, other than its own"
        },
        {
          "name": "fields",
          "type": "list",
          "elem": "string",
          "doc": "The field names; empty for every translatable field of the record"
        }
      ]
    },
    {
      "verb": "suggest-translation",
      "summary": "Ask the machine for a draft of a content",
      "description": "Saves the machine's text as a draft nobody has reviewed; it is never served publicly until a person marks it reviewed. Refuses, writing nothing, when the installation names no machine translator.",
      "fields": [
        {
          "name": "lang",
          "type": "string",
          "doc": "The language this acts on: a tag this tenant is served in, other than its own"
        },
        {
          "name": "fields",
          "type": "list",
          "elem": "string",
          "doc": "The field names; empty for every translatable field of the record"
        }
      ]
    },
    {
      "verb": "untranslate",
      "summary": "Remove a content's translation",
      "description": "Deletes this language's rows for the named fields, or for every field when none is named. The record itself is untouched.",
      "fields": [
        {
          "name": "lang",
          "type": "string",
          "doc": "The language this acts on: a tag this tenant is served in, other than its own"
        },
        {
          "name": "fields",
          "type": "list",
          "elem": "string",
          "doc": "The field names; empty for every translatable field of the record"
        }
      ]
    },
    {
      "verb": "publish",
      "summary": "Publish content",
      "description": "Serves it to anybody, and records when. Publishing what is already published changes nothing; the publication time does not move.",
      "presentation": {
        "label": "Publicar"
      }
    },
    {
      "verb": "unpublish",
      "summary": "Unpublish content",
      "description": "Takes it back to a draft, from published or from archived, and clears the publication time.",
      "presentation": {
        "label": "Despublicar"
      }
    },
    {
      "verb": "archive",
      "summary": "Archive content",
      "description": "Keeps it and serves it to nobody. Archiving twice changes nothing.",
      "presentation": {
        "label": "Arquivar",
        "destructive": true,
        "confirmation": {
          "title": "Arquivar esta página?",
          "body": "Deixa de ser exibida. Pode voltar a publicá-la mais tarde.",
          "confirmLabel": "Arquivar"
        }
      }
    }
  ]
