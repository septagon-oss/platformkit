{
  "commands": [
    {
      "description": "Makes somebody responsible, and acknowledges an open task. Assigning the same person again changes nothing.",
      "fields": [
        {
          "doc": "The user who becomes responsible",
          "name": "assigneeId",
          "presentation": {
            "label": "Respons\u00e1vel"
          },
          "type": "uuid"
        }
      ],
      "presentation": {
        "label": "Atribuir"
      },
      "summary": "Assign a task",
      "verb": "assign"
    },
    {
      "description": "Closes the loop. Repeating it with the same resolution changes nothing; a different one is refused.",
      "fields": [
        {
          "doc": "How the task was resolved",
          "maxLength": 4000,
          "name": "resolution",
          "type": "string"
        }
      ],
      "presentation": {
        "label": "Resolver"
      },
      "summary": "Resolve a task",
      "verb": "resolve"
    },
    {
      "description": "Records a breach if the deadline has passed with the task unresolved. Records at most one.",
      "presentation": {
        "system": true
      },
      "summary": "Check a task's SLA",
      "verb": "check-sla"
    }
  ],
  "entity": "task",
  "fields": [
    {
      "name": "id",
      "readOnly": true,
      "type": "uuid"
    },
    {
      "name": "createdAt",
      "readOnly": true,
      "type": "time"
    },
    {
      "name": "updatedAt",
      "readOnly": true,
      "type": "time"
    },
    {
      "doc": "Short summary of the task",
      "maxLength": 200,
      "name": "title",
      "required": true,
      "type": "string"
    },
    {
      "doc": "Detailed description of the task",
      "hideList": true,
      "name": "description",
      "type": "text",
      "widget": "textarea"
    },
    {
      "default": "open",
      "doc": "Lifecycle state",
      "enum": [
        "open",
        "acknowledged",
        "in_progress",
        "resolved",
        "closed"
      ],
      "name": "status",
      "presentation": {
        "doneValues": [
          "resolved"
        ],
        "enumTones": {
          "acknowledged": "info",
          "closed": "neutral",
          "in_progress": "warning",
          "open": "info",
          "resolved": "success"
        }
      },
      "type": "string",
      "widget": "select"
    },
    {
      "default": "normal",
      "doc": "Task priority",
      "enum": [
        "low",
        "normal",
        "high",
        "critical"
      ],
      "name": "priority",
      "presentation": {
        "enumTones": {
          "critical": "danger",
          "high": "warning",
          "low": "neutral",
          "normal": "neutral"
        }
      },
      "type": "string",
      "widget": "select"
    },
    {
      "doc": "Origin of the task",
      "name": "source",
      "presentation": {
        "visibility": "hidden"
      },
      "type": "string"
    },
    {
      "doc": "Reference into the source system",
      "name": "sourceRef",
      "presentation": {
        "visibility": "hidden"
      },
      "type": "string"
    },
    {
      "doc": "User responsible for the task",
      "name": "assigneeId",
      "presentation": {
        "label": "Respons\u00e1vel",
        "reference": {
          "resource": "user/user"
        },
        "visibility": "detail"
      },
      "type": "uuid",
      "widget": "entity-picker"
    },
    {
      "doc": "Soft target completion time",
      "name": "dueAt",
      "presentation": {
        "label": "Prazo"
      },
      "type": "time",
      "widget": "datetime"
    },
    {
      "doc": "Hard SLA deadline; a breach is measured against this",
      "name": "slaDeadline",
      "presentation": {
        "label": "Resposta devida"
      },
      "type": "time",
      "widget": "datetime"
    },
    {
      "default": "false",
      "doc": "True once the deadline elapsed with the task unresolved",
      "name": "slaBreached",
      "presentation": {
        "label": "Resposta atrasada"
      },
      "type": "bool",
      "widget": "checkbox"
    },
    {
      "doc": "When the task was resolved",
      "hideList": true,
      "name": "resolvedAt",
      "presentation": {
        "label": "Resolvida"
      },
      "type": "time",
      "widget": "datetime"
    },
    {
      "doc": "How the task was resolved",
      "hideList": true,
      "name": "resolution",
      "type": "text",
      "widget": "textarea"
    },
    {
      "doc": "This row's own write count, from 1",
      "name": "revision",
      "type": "int"
    }
  ],
  "immutable": [
    "assigneeId",
    "slaBreached",
    "resolvedAt",
    "resolution"
  ],
