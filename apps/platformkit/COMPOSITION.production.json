{
  "schema": "platformkit.composition.v1",
  "app": "platformkit",
  "environment": "production",
  "resolved": true,
  "modules": [
    {
      "name": "product",
      "provides": [
        "usercontracts.Administration",
        "usercontracts.Granting",
        "filecontracts.Storage",
        "auditcontracts.Plan",
        "tenancy.Policy",
        "sitecontracts.WriteGate",
        "rest.Gate",
        "webcontracts.Links",
        "rest.TranslationSource",
        "admincontracts.Signin",
        "admincontracts.Pictures",
        "admincontracts.Locale",
        "tenantcontracts.Languages",
        "webhookcontracts.Catalogue"
      ],
      "contributes": [
        {
          "contract": "tenantcontracts.Hook",
          "to": [
            "tenant"
          ]
        },
        {
          "contract": "changecontracts.SubjectBinding",
          "to": [
            "change"
          ]
        }
      ],
      "reads": [
        "config.Files"
      ]
    },
    {
      "name": "seed",
      "contributes": [
        {
          "contract": "tenantcontracts.Hook",
          "to": [
            "tenant"
          ]
        }
      ]
    },
    {
      "name": "user",
      "provides": [
        "usercontracts.Service",
        "authcontracts.Users",
        "authcontracts.Provisioner",
        "notificationcontracts.RecipientLookup",
        "tenantcontracts.Inviter"
      ],
      "needs": [
        {
          "contract": "usercontracts.Administration",
          "from": "product"
        },
        {
          "contract": "usercontracts.Granting",
          "from": "product"
        }
      ],
      "after": [
        "product"
      ]
    },
    {
      "name": "translation",
      "provides": [
        "rest.Translations"
      ],
      "needs": [
        {
          "contract": "rest.TranslationSource",
          "from": "product"
        }
      ],
      "after": [
        "product"
      ]
    },
    {
      "name": "site",
      "provides": [
        "sitecontracts.Service",
        "sitecontracts.LockedReader"
      ],
      "uses": [
        {
          "contract": "sitecontracts.WriteGate",
          "from": "product"
        }
      ],
      "after": [
        "product"
      ]
    },
    {
      "name": "tenant",
      "provides": [
        "tenantcontracts.Service",
        "httpx.TenantLoader",
        "jobs.TenantLister",
        "notificationcontracts.HostLookup",
        "authcontracts.OIDCProviders",
        "authcontracts.SAMLProviders"
      ],
      "needs": [
        {
          "contract": "tenantcontracts.Inviter",
          "from": "user"
        }
      ],
      "uses": [
        {
          "contract": "tenantcontracts.Languages",
          "from": "product"
        }
      ],
      "takes": [
        {
          "contract": "tenantcontracts.Hook",
          "from": [
            "product",
            "seed"
          ]
        }
      ],
      "after": [
        "product",
        "user",
        "seed"
      ],
      "reads": [
        "config.NATS",
        "config.Server"
      ]
    },
    {
      "name": "emailregistration",
      "provides": [
        "authcontracts.RegistrationMode"
      ],
      "needs": [
        {
          "contract": "usercontracts.Service",
          "from": "user"
        }
      ],
      "after": [
        "user"
      ]
    },
    {
      "name": "notification",
      "provides": [
        "notificationcontracts.Service",
        "authcontracts.Notifier",
        "notificationcontracts.Mailer",
        "notificationcontracts.MailLedger"
      ],
      "needs": [
        {
          "contract": "notificationcontracts.RecipientLookup",
          "from": "user"
        },
        {
          "contract": "notificationcontracts.HostLookup",
          "from": "tenant"
        }
      ],
      "after": [
        "user",
        "tenant"
      ],
      "reads": [
        "config.Mail",
        "config.Server"
      ],
      "implementation": {
        "name": "mailbox"
      }
    },
    {
      "name": "task",
      "provides": [
        "taskcontracts.Service"
      ],
      "needs": [
        {
          "contract": "jobs.TenantLister",
          "from": "tenant"
        }
      ],
      "uses": [
        {
          "contract": "tenancy.Policy",
          "from": "product"
        },
        {
          "contract": "rest.Gate",
          "from": "product"
        }
      ],
      "after": [
        "product",
        "tenant"
      ]
    },
    {
      "name": "billing",
      "provides": [
        "httpx.Entitler"
      ],
      "needs": [
        {
          "contract": "jobs.TenantLister",
          "from": "tenant"
        }
      ],
      "after": [
        "tenant"
      ],
      "implementation": {
        "name": "manual"
      }
    },
    {
      "name": "audit",
      "needs": [
        {
          "contract": "jobs.TenantLister",
          "from": "tenant"
        }
      ],
      "uses": [
        {
          "contract": "auditcontracts.Plan",
          "from": "product"
        }
      ],
      "after": [
        "product",
        "tenant"
      ],
      "reads": [
        "config.Audit",
        "config.Database"
      ]
    },
    {
      "name": "webhook",
      "needs": [
        {
          "contract": "jobs.TenantLister",
          "from": "tenant"
        },
        {
          "contract": "webhookcontracts.Catalogue",
          "from": "product"
        }
      ],
      "uses": [
        {
          "contract": "webhookcontracts.Alerts",
          "from": ""
        }
      ],
      "after": [
        "product",
        "tenant"
      ],
      "reads": [
        "config.Webhook"
      ]
    },
    {
      "name": "auth",
      "provides": [
        "authcontracts.Auth",
        "httpx.Authorizer",
        "pkit.Authenticator"
      ],
      "needs": [
        {
          "contract": "authcontracts.Users",
          "from": "user"
        },
        {
          "contract": "authcontracts.Provisioner",
          "from": "user"
        },
        {
          "contract": "authcontracts.Notifier",
          "from": "notification"
        },
        {
          "contract": "notificationcontracts.Mailer",
          "from": "notification"
        },
        {
          "contract": "notificationcontracts.HostLookup",
          "from": "tenant"
        },
        {
          "contract": "notificationcontracts.MailLedger",
          "from": "notification"
        },
        {
          "contract": "authcontracts.OIDCProviders",
          "from": "tenant"
        },
        {
          "contract": "jobs.TenantLister",
          "from": "tenant"
        },
        {
          "contract": "usercontracts.Granting",
          "from": "product"
        }
      ],
      "uses": [
        {
          "contract": "authcontracts.SAMLProviders",
          "from": "tenant"
        },
        {
          "contract": "authcontracts.RegistrationMode",
          "from": "emailregistration"
        }
      ],
      "after": [
        "product",
        "user",
        "tenant",
        "notification",
        "emailregistration"
      ],
      "reads": [
        "config.Auth",
        "config.Server"
      ]
    },
    {
      "name": "media",
      "provides": [
        "*file.LibraryChrome"
      ],
      "needs": [
        {
          "contract": "authcontracts.Auth",
          "from": "auth"
        }
      ],
      "after": [
        "auth"
      ]
    },
    {
      "name": "access",
      "provides": [
        "changecontracts.Notifier",
        "changecontracts.ProposalPage",
        "*change.ReviewChrome"
      ],
      "needs": [
        {
          "contract": "usercontracts.Service",
          "from": "user"
        },
        {
          "contract": "notificationcontracts.Service",
          "from": "notification"
        },
        {
          "contract": "sitecontracts.Service",
          "from": "site"
        },
        {
          "contract": "sitecontracts.LockedReader",
          "from": "site"
        },
        {
          "contract": "usercontracts.Granting",
          "from": "product"
        },
        {
          "contract": "authcontracts.Auth",
          "from": "auth"
        }
      ],
      "contributes": [
        {
          "contract": "changecontracts.SubjectBinding",
          "to": [
            "change"
          ]
        }
      ],
      "after": [
        "product",
        "user",
        "notification",
        "auth",
        "site"
      ]
    },
    {
      "name": "file",
      "provides": [
        "filecontracts.Service",
        "richtext.Files",
        "rest.FileUses",
        "rest.FileShown"
      ],
      "needs": [
        {
          "contract": "filecontracts.Storage",
          "from": "product"
        },
        {
          "contract": "jobs.TenantLister",
          "from": "tenant"
        }
      ],
      "uses": [
        {
          "contract": "*file.LibraryChrome",
          "from": "media"
        }
      ],
      "after": [
        "product",
        "tenant",
        "media"
      ],
      "reads": [
        "config.Files"
      ]
    },
    {
      "name": "change",
      "provides": [
        "changecontracts.Service"
      ],
      "uses": [
        {
          "contract": "changecontracts.Notifier",
          "from": "access"
        },
        {
          "contract": "changecontracts.ProposalPage",
          "from": "access"
        },
        {
          "contract": "*change.ReviewChrome",
          "from": "access"
        }
      ],
      "takes": [
        {
          "contract": "changecontracts.SubjectBinding",
          "from": [
            "product",
            "access"
          ]
        }
      ],
      "after": [
        "product",
        "access"
      ]
    },
    {
      "name": "history",
      "provides": [
        "historycontracts.Service",
        "httpx.Versions"
      ],
      "needs": [
        {
          "contract": "rest.FileUses",
          "from": "file"
        },
        {
          "contract": "jobs.TenantLister",
          "from": "tenant"
        }
      ],
      "after": [
        "tenant",
        "file"
      ]
    },
    {
      "name": "content",
      "provides": [
        "contentcontracts.Service"
      ],
      "needs": [
        {
          "contract": "richtext.Files",
          "from": "file"
        },
        {
          "contract": "rest.FileUses",
          "from": "file"
        },
        {
          "contract": "rest.Translations",
          "from": "translation"
        },
        {
          "contract": "rest.FileShown",
          "from": "file"
        },
        {
          "contract": "httpx.Versions",
          "from": "history"
        }
      ],
      "after": [
        "file",
        "history",
        "translation"
      ]
    },
    {
      "name": "web",
      "needs": [
        {
          "contract": "sitecontracts.Service",
          "from": "site"
        },
        {
          "contract": "contentcontracts.Service",
          "from": "content"
        },
        {
          "contract": "richtext.Files",
          "from": "file"
        }
      ],
      "uses": [
        {
          "contract": "webcontracts.Links",
          "from": "product"
        },
        {
          "contract": "rest.Translations",
          "from": "translation"
        },
        {
          "contract": "rest.TranslationSource",
          "from": "product"
        }
      ],
      "after": [
        "product",
        "file",
        "translation",
        "content",
        "site"
      ]
    },
    {
      "name": "admin",
      "needs": [
        {
          "contract": "authcontracts.Auth",
          "from": "auth"
        },
        {
          "contract": "tenantcontracts.Service",
          "from": "tenant"
        }
      ],
      "uses": [
        {
          "contract": "admincontracts.Signin",
          "from": "product"
        },
        {
          "contract": "admincontracts.Pictures",
          "from": "product"
        },
        {
          "contract": "admincontracts.Locale",
          "from": "product"
        },
        {
          "contract": "admincontracts.Storybook",
          "from": ""
        }
      ],
      "after": [
        "product",
        "tenant",
        "auth"
      ],
      "runsLast": true
    }
  ],
  "roles": [
    {
      "name": "coordinator",
      "grants": [
        "task:read",
        "task:update"
      ]
    },
    {
      "name": "observer",
      "grants": [
        "task:read"
      ]
    }
  ],
  "problems": [],
  "cloud": {
    "profile": "local",
    "environment": "production",
    "seams": [
      {
        "seam": "storage",
        "provider": "local-disk",
        "source": "default",
        "served": true
      },
      {
        "seam": "cache",
        "provider": "in-process",
        "source": "default",
        "served": true
      },
      {
        "seam": "events",
        "provider": "by-role",
        "source": "default",
        "served": true
      },
      {
        "seam": "mail",
        "provider": "mailbox",
        "source": "default",
        "served": true
      },
      {
        "seam": "policy",
        "provider": "rego-in-process",
        "source": "kernel",
        "served": false,
        "note": "not a cloud seam"
      },
      {
        "seam": "telemetry",
        "provider": "none",
        "source": "default",
        "served": true
      },
      {
        "seam": "identity",
        "provider": "password-only",
        "source": "default",
        "served": true
      },
      {
        "seam": "flags",
        "provider": "configuration",
        "source": "kernel",
        "served": false,
        "note": "not a cloud seam"
      }
    ]
  }
}
