      ],
      "suffixes": [
        ".go"
      ],
      "exclude_suffixes": [
        "_test.go"
      ],
      "max": 25100
    },
    {
      "name": "apps",
      "paths": [
        "apps/"
      ],
      "suffixes": [
        ".go"
      ],
      "exclude_suffixes": [
        "_test.go"
      ],
      "max": 2016
    },
    {
      "name": "tools",
      "paths": [
        "tools/"
      ],
      "suffixes": [
        ".go"
      ],
      "exclude_suffixes": [
        "_test.go"
      ],
      "max": 600
