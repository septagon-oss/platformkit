      ],
      "max": 16328
    },
    {
      "name": "apps",
      "paths": [
        "apps/"
      ],
      "suffixes": [
        ".go"
      ],
      "exclude_suffixes": [
        "_test.go"
      ],
      "max": 800
    },
    {
      "name": "tools",
      "paths": [
        "tools/"
      ],
      "suffixes": [
        ".go"
      ],
      "exclude_suffixes": [
        "_test.go"
      ],
      "max": 500
