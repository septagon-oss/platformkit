{
  "buckets": [
    {
      "name": "kit",
      "paths": [
        "kit/"
      ],
      "suffixes": [
        ".go"
      ],
      "exclude_suffixes": [
        "_test.go"
      ],
      "max": 8200
    },
    {
      "name": "modules",
      "paths": [
        "modules/"
      ],
      "suffixes": [
        ".go"
      ],
      "exclude_suffixes": [
        "_test.go"
      ],
      "exclude_dir_suffixes": [
        "test"
      ],
      "max": 11700
    },
    {
      "name": "ui",
      "paths": [
        "ui/",
        "design/"
      ],
      "suffixes": [
        ".go"
      ],
      "exclude_suffixes": [
        "_test.go"
      ],
      "max": 9600
    },
    {
      "name": "apps",
      "paths": [
        "apps/"
      ],
      "suffixes": [
        ".go"
      ],
      "exclude_suffixes": [
        "_test.go"
      ],
      "max": 500
    },
    {
      "name": "tools",
      "paths": [
        "tools/"
      ],
      "suffixes": [
        ".go"
      ],
      "exclude_suffixes": [
        "_test.go"
      ],
      "max": 400
    },
    {
      "name": "go_prod",
      "suffixes": [
        ".go"
      ],
      "exclude_suffixes": [
        "_test.go"
      ],
      "exclude_dir_suffixes": [
        "test"
      ],
      "max": 29900
    },
    {
      "name": "go_testsupport",
      "suffixes": [
        ".go"
      ],
      "exclude_suffixes": [
        "_test.go"
      ],
      "dir_suffixes": [
        "test"
      ],
      "max": 5600
    },
    {
      "name": "go_test",
      "suffixes": [
        "_test.go"
      ],
      "max": 18200
    },
    {
      "name": "js",
      "paths": [
        "ui/assets/js/"
      ],
      "suffixes": [
        ".js"
      ],
      "exclude_suffixes": [
        ".min.js"
      ],
      "max": 300
    },
    {
      "name": "markdown",
      "suffixes": [
        ".md"
      ],
      "max": 1700
    }
  ]
}
