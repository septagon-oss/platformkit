{
  "buckets": [
    {
      "name": "kit",
      "paths": [
        "kit/"
      ],
      "suffixes": [
        ".go"
      ],
      "exclude_suffixes": [
        "_test.go"
      ],
      "max": 8500
    },
    {
      "name": "modules",
      "paths": [
        "modules/"
      ],
      "suffixes": [
        ".go"
      ],
      "exclude_suffixes": [
        "_test.go"
      ],
      "exclude_dir_suffixes": [
        "test"
      ],
      "max": 12300
    },
    {
      "name": "ui",
      "paths": [
        "ui/",
        "design/"
      ],
      "suffixes": [
        ".go"
      ],
      "exclude_suffixes": [
        "_test.go"
      ],
      "max": 12800
    },
    {
      "name": "apps",
      "paths": [
        "apps/"
      ],
      "suffixes": [
        ".go"
      ],
      "exclude_suffixes": [
        "_test.go"
      ],
      "max": 800
    },
    {
      "name": "tools",
      "paths": [
        "tools/"
      ],
      "suffixes": [
        ".go"
      ],
      "exclude_suffixes": [
        "_test.go"
      ],
      "max": 500
    },
    {
      "name": "go_prod",
      "suffixes": [
        ".go"
      ],
      "exclude_suffixes": [
        "_test.go"
      ],
      "exclude_dir_suffixes": [
        "test"
      ],
      "max": 33900
    },
    {
      "name": "go_testsupport",
      "suffixes": [
        ".go"
      ],
      "exclude_suffixes": [
        "_test.go"
      ],
      "dir_suffixes": [
        "test"
      ],
      "max": 5900
    },
    {
      "name": "go_test",
      "suffixes": [
        "_test.go"
      ],
      "max": 24000
    },
    {
      "name": "js",
      "paths": [
        "ui/assets/js/"
      ],
      "suffixes": [
        ".js"
      ],
      "exclude_suffixes": [
        ".min.js"
      ],
      "max": 300
    },
    {
      "name": "design_tooling",
      "paths": [
        "tools/designexport/openpencil/"
      ],
      "suffixes": [
        ".js",
        ".mjs",
        ".ts"
      ],
      "exclude_suffixes": [
        ".test.js",
        ".test.mjs",
        ".test.ts"
      ],
      "max": 7100
    },
    {
      "name": "design_tooling_test",
      "paths": [
        "tools/designexport/openpencil/"
      ],
      "suffixes": [
        ".test.js",
        ".test.mjs",
        ".test.ts"
      ],
      "max": 13600
    },
    {
      "name": "markdown",
      "suffixes": [
        ".md"
      ],
      "max": 2200
    }
  ]
}
