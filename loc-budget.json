{
  "buckets": [
    {
      "name": "kit",
      "paths": [
        "kit/"
      ],
      "suffixes": [
        ".go"
      ],
      "exclude_suffixes": [
        "_test.go"
      ],
      "max": 53400
    },
    {
      "name": "modules",
      "paths": [
        "modules/"
      ],
      "suffixes": [
        ".go"
      ],
      "exclude_suffixes": [
        "_test.go"
      ],
      "exclude_dir_suffixes": [
        "test"
      ],
      "max": 53900
    },
    {
      "name": "ui",
      "paths": [
        "ui/",
        "design/"
      ],
      "suffixes": [
        ".go"
      ],
      "exclude_suffixes": [
        "_test.go"
      ],
      "max": 29000
    },
    {
      "name": "apps",
      "paths": [
        "apps/"
      ],
      "suffixes": [
        ".go"
      ],
      "exclude_suffixes": [
        "_test.go"
      ],
      "max": 5300
    },
    {
      "name": "tools",
      "paths": [
        "tools/"
      ],
      "suffixes": [
        ".go"
      ],
      "exclude_suffixes": [
        "_test.go"
      ],
      "max": 700
    },
    {
      "name": "go_prod",
      "suffixes": [
        ".go"
      ],
      "exclude_suffixes": [
        "_test.go"
      ],
      "exclude_dir_suffixes": [
        "test"
      ],
      "max": 141200
    },
    {
      "name": "go_testsupport",
      "suffixes": [
        ".go"
      ],
      "exclude_suffixes": [
        "_test.go"
      ],
      "dir_suffixes": [
        "test"
      ],
      "max": 20300
    },
    {
      "name": "go_test",
      "suffixes": [
        "_test.go"
      ],
      "max": 215400
    },
    {
      "name": "js",
      "paths": [
        "ui/assets/js/"
      ],
      "suffixes": [
        ".js"
      ],
      "exclude_suffixes": [
        ".min.js"
      ],
      "max": 2600
    },
    {
      "name": "design_tooling",
      "paths": [
        "tools/designexport/openpencil/"
      ],
      "suffixes": [
        ".js",
        ".mjs",
        ".ts"
      ],
      "exclude_suffixes": [
        ".test.js",
        ".test.mjs",
        ".test.ts"
      ],
      "max": 10600
    },
    {
      "name": "design_tooling_test",
      "paths": [
        "tools/designexport/openpencil/"
      ],
      "suffixes": [
        ".test.js",
        ".test.mjs",
        ".test.ts"
      ],
      "max": 22400
    },
    {
      "name": "markdown",
      "suffixes": [
        ".md"
      ],
      "max": 21400
    }
  ]
}
