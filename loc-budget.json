    {
      "name": "go_prod",
      "suffixes": [
        ".go"
      ],
      "exclude_suffixes": [
        "_test.go"
      ],
      "exclude_dir_suffixes": [
        "test"
      ],
      "max": 89820
    },
    {
      "name": "go_testsupport",
      "suffixes": [
