      "exclude_suffixes": [
        "_test.go"
      ],
      "max": 30300
    },
    {
      "name": "modules",
      "paths": [
        "modules/"
      ],
      "suffixes": [
        ".go"
      ],
      "exclude_suffixes": [
        "_test.go"
      ],
      "exclude_dir_suffixes": [
        "test"
      ],
      "max": 30734
    },
    {
