{
  "buckets": [
    {
      "name": "kit",
      "paths": [
        "kit/"
      ],
      "suffixes": [
        ".go"
      ],
      "exclude_suffixes": [
        "_test.go"
      ],
      "max": 15700
    },
    {
      "name": "modules",
      "paths": [
        "modules/"
      ],
      "suffixes": [
        ".go"
      ],
      "exclude_suffixes": [
        "_test.go"
      ],
      "exclude_dir_suffixes": [
        "test"
      ],
      "max": 15000
    },
    {
      "name": "ui",
      "paths": [
        "ui/",
        "design/"
      ],
      "suffixes": [
        ".go"
      ],
      "exclude_suffixes": [
        "_test.go"
      ],
      "max": 18018
    },
    {
      "name": "apps",
      "paths": [
        "apps/"
      ],
      "suffixes": [
        ".go"
      ],
      "exclude_suffixes": [
        "_test.go"
      ],
      "max": 1100
    },
    {
      "name": "tools",
      "paths": [
        "tools/"
      ],
      "suffixes": [
        ".go"
      ],
      "exclude_suffixes": [
        "_test.go"
      ],
      "max": 600
    },
    {
      "name": "go_prod",
      "suffixes": [
        ".go"
      ],
      "exclude_suffixes": [
        "_test.go"
      ],
      "exclude_dir_suffixes": [
        "test"
      ],
      "max": 50000
    },
    {
      "name": "go_testsupport",
      "suffixes": [
        ".go"
      ],
      "exclude_suffixes": [
        "_test.go"
      ],
      "dir_suffixes": [
        "test"
      ],
      "max": 6900
    },
    {
      "name": "go_test",
      "suffixes": [
        "_test.go"
      ],
      "max": 59500
    },
    {
      "name": "js",
      "paths": [
        "ui/assets/js/"
      ],
      "suffixes": [
        ".js"
      ],
      "exclude_suffixes": [
        ".min.js"
      ],
      "max": 900
    },
    {
      "name": "design_tooling",
      "paths": [
        "tools/designexport/openpencil/"
      ],
      "suffixes": [
        ".js",
        ".mjs",
        ".ts"
      ],
      "exclude_suffixes": [
        ".test.js",
        ".test.mjs",
        ".test.ts"
      ],
      "max": 11200
    },
    {
      "name": "design_tooling_test",
      "paths": [
        "tools/designexport/openpencil/"
      ],
      "suffixes": [
        ".test.js",
        ".test.mjs",
        ".test.ts"
      ],
      "max": 22800
    },
    {
      "name": "markdown",
      "suffixes": [
        ".md"
      ],
      "max": 7000
    }
  ]
}
