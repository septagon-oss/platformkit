{
  "resources": [
    {
      "module": "note",
      "entity": "note",
      "path": "/api/v1/note/notes",
      "fields": [
        {
          "name": "id",
          "type": "uuid",
          "readOnly": true
        },
        {
          "name": "createdAt",
          "type": "time",
          "readOnly": true
        },
        {
          "name": "updatedAt",
          "type": "time",
          "readOnly": true
        },
        {
          "name": "title",
          "type": "string",
          "required": true,
          "doc": "What this note is about"
        },
        {
          "name": "body",
          "type": "text",
          "widget": "textarea",
          "hideList": true
        },
        {
          "name": "status",
          "type": "string",
          "enum": [
            "open",
            "done"
          ],
          "default": "open"
        },
        {
          "name": "rank",
          "type": "int"
        },
        {
          "name": "pinned",
          "type": "bool"
        },
        {
          "name": "tags",
          "type": "list",
          "elem": "string"
        }
      ],
      "immutable": [
        "status"
      ],
      "writable": true,
      "commands": [
        {
          "verb": "publish",
          "summary": "Publish a note",
          "description": "Makes the note visible. Publishing a published note changes nothing.",
          "fields": [
            {
              "name": "at",
              "type": "string",
              "doc": "When it goes out; now if left empty"
            }
          ]
        },
        {
          "verb": "archive",
          "summary": "Archive every resolved note",
          "description": "Takes what is finished out of the way.",
          "collection": true
        }
      ]
    },
    {
      "module": "note",
      "entity": "tag",
      "path": "/api/v1/note/tags",
      "fields": [
        {
          "name": "id",
          "type": "uuid",
          "readOnly": true
        },
        {
          "name": "createdAt",
          "type": "time",
          "readOnly": true
        },
        {
          "name": "updatedAt",
          "type": "time",
          "readOnly": true
        },
        {
          "name": "title",
          "type": "string",
          "required": true,
          "doc": "What this note is about"
        },
        {
          "name": "body",
          "type": "text",
          "widget": "textarea",
          "hideList": true
        },
        {
          "name": "status",
          "type": "string",
          "enum": [
            "open",
            "done"
          ],
          "default": "open"
        },
        {
          "name": "rank",
          "type": "int"
        },
        {
          "name": "pinned",
          "type": "bool"
        },
        {
          "name": "tags",
          "type": "list",
          "elem": "string"
        }
      ],
      "writable": false
    }
  ]
}
