{
  "name": "@platformkit/openpencil-adapter",
  "private": true,
  "type": "module",
  "engines": { "node": ">=24.0.0" },
  "scripts": {
    "generate": "node ./generate.mjs",
    "test": "node --import ./register.mjs --test *.test.mjs",
    "test:browser": "node --import ./register.mjs --test browser/*.test.mjs",
    "test:stock": "node --test native.test.mjs"
  },
  "dependencies": {
    "@open-pencil/core": "0.14.0",
    "@open-pencil/fig": "0.14.0",
    "@open-pencil/scene-graph": "0.14.0",
    "@xmldom/xmldom": "0.9.12",
    "defu": "6.1.7",
    "fflate": "0.8.3",
    "opentype.js": "2.0.0",
    "playwright": "1.62.1",
    "svgpath": "2.6.0",
    "unhead": "2.1.13",
    "valibot": "1.4.2"
  },
  "devDependencies": {
    "@fontsource/ibm-plex-sans": "5.3.0"
  },
  "overrides": {
    "@open-pencil/core": {
      "expr-eval": "npm:expr-eval-fork@3.0.3",
      "pptxgenjs": "npm:@neo-ma/pptxgenjs@4.3.0"
    },
    "@open-pencil/fig": "0.14.0",
    "@open-pencil/kiwi": "0.14.0",
    "@open-pencil/pen": "0.14.0",
    "@open-pencil/scene-graph": "0.14.0"
  }
}
